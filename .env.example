# ══════════════════════════════════════════════════════════════
# CarGuinée — Variables d'environnement (Production)
# Copier vers .env et remplir les valeurs
# ══════════════════════════════════════════════════════════════

# PostgreSQL
POSTGRES_DB=carguine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT (générer avec: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_EXPIRES_IN=7d

# CORS (domaine du frontend en production)
CORS_ORIGIN=https://carguine.com

# Orange Money API (sandbox)
OM_APP_KEY=
OM_APP_SECRET=
OM_MERCHANT_KEY=
OM_SANDBOX=true

# LibreTranslate (optionnel)
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Sentry (optionnel - à configurer)
# SENTRY_DSN=

# Frontend (pour Docker runtime injection)
VITE_API_URL=http://localhost:3000
