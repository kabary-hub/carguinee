              }
            }
          ]
        },
        {
          "name": "Create Vehicle (Owner)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/vehicles",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"brand\":\"Toyota\",\"model\":\"Corolla\",\"year\":2020,\"type\":\"BERLINE\",\"commune\":\"KALOUM\",\"quartier\":\"Centre\",\"descriptionFr\":\"Bonne voiture\",\"supportsRental\":true,\"supportsSale\":false,\"dailyRentalPriceGnf\":150000}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vehicle created or 403 if not owner', () => {",
                  "  pm.expect([201, 403]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('vehicleId', json.data.id);",
                  "  console.log('Vehicle ID saved:', json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "My Vehicles (Owner)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/vehicles/mine",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Owner vehicles returned', () => {",
                  "  pm.expect([200, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Vehicles List",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/admin/all?page=1&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "admin", "all"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" }
              ]
            },
            "header": [
