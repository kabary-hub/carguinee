          "name": "List with Filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?type=SUV&pageSize=3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"],
              "query": [
                { "key": "type", "value": "SUV" },
                { "key": "pageSize", "value": "3" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
