{
  "info": {
    "name": "CarGuinée API",
    "description": "Collection complète de l'API CarGuinée — Plateforme de location & vente de véhicules en Guinée.\n\nBase URL : http://localhost:3000/api\n\n# Authentification\nLa plupart des routes nécessitent un token JWT.\n1. Utiliser `POST /api/auth/login` pour obtenir le token\n2. Le token est automatiquement stocké dans la variable `{{token}}`\n3. Les routes protégées l'utilisent via le header `Authorization: Bearer {{token}}`\n\n# Variables\n- `{{baseUrl}}` = http://localhost:3000/api\n- `{{token}}` = JWT token (automatiquement défini après login)\n- `{{vehicleId}}` = ID d'un véhicule\n- `{{bookingId}}` = ID d'une réservation\n- `{{userId}}` = ID d'un utilisateur",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "vehicleId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "🔐 Authentification",
      "item": [
        {
          "name": "Inscription",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Amadou\",\n  \"lastName\": \"Diallo\",\n  \"phone\": \"+2246201234567\",\n  \"password\": \"SecurePass123!\"\n}"
            }
          }
        },
        {
          "name": "Connexion",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+2246201234567\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var jsonData = pm.response.json();",
                    "if (jsonData.data && jsonData.data.token) {",
                    "  pm.environment.set('token', jsonData.data.token);",
                    "  console.log('Token sauvegardé');",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Profil utilisateur (GET /me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Modifier profil (PATCH /me)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Amadou\",\n  \"lastName\": \"Diallo\"\n}"
            }
          }
        },
        {
          "name": "Changer mot de passe",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/change-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"SecurePass123!\",\n  \"newPassword\": \"NewSecurePass456!\"\n}"
            }
          }
        },
        {
          "name": "Mot de passe oublié",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/forgot-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+2246201234567\"\n}"
            }
          }
        },
        {
          "name": "Vérifier code réinitialisation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/verify-reset-code",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+2246201234567\",\n  \"code\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Réinitialiser mot de passe",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/reset-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+2246201234567\",\n  \"code\": \"123456\",\n  \"newPassword\": \"ResetPass789!\"\n}"
            }
          }
        },
        {
          "name": "Déconnexion",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "CSRF Refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/csrf-refresh"
          }
        }
      ]
    },
    {
      "name": "🚗 Véhicules",
      "item": [
        {
          "name": "Liste véhicules (publiques)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/vehicles?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["vehicles"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "brand", "value": "", "disabled": true },
                { "key": "minPrice", "value": "", "disabled": true },
                { "key": "maxPrice", "value": "", "disabled": true },
                { "key": "commune", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Détails véhicule",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}"
          }
        },
        {
          "name": "Mes véhicules (propriétaire)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/vehicles/mine"
          }
        },
        {
          "name": "Créer un véhicule",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/vehicles",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Toyota\",\n  \"model\": \"Hilux\",\n  \"year\": 2022,\n  \"pricePerDay\": 150000,\n  \"commune\": \"Ratoma\",\n  \"quartier\": \"Kipé\",\n  \"description\": \"Pick-up en excellent état\",\n  \"seats\": 5,\n  \"fuelType\": \"Diesel\",\n  \"transmission\": \"Manuelle\"\n}"
            }
          }
        },
        {
          "name": "Modifier un véhicule",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pricePerDay\": 120000\n}"
            }
          }
        },
        {
          "name": "Archiver un véhicule",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}/archive"
          }
        },
        {
          "name": "Restaurer un véhicule",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}/restore"
          }
        },
        {
          "name": "Soumettre pour validation",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}/submit"
          }
        },
        {
          "name": "Approuver (admin)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}/approve"
          }
        },
        {
          "name": "Rejeter (admin)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}/reject",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Photos de mauvaise qualité\"\n}"
            }
          }
        },
        {
          "name": "Uploader photo",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}/photos",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "photos", "type": "file", "src": "/path/to/photo.jpg" }
              ]
            }
          }
        },
        {
          "name": "Supprimer photo",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}/photos/{{photoId}}"
          }
        }
      ]
    },
