    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
